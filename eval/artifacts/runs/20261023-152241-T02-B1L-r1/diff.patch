+async def _loans(loan_ids: list[int]) -> list[Loan]:
+    async with db.sessionmaker()() as s:
+        return list((await s.scalars(select(Loan).where(Loan.id.in_(loan_ids)))).all())
+
+
+async def test_loan_due_in_21_days_and_flagged_overdue_after() -> None:
+    app_id, _ = await paid_application()
+    loan_ids = await issue(app_id)
+    issued_at = clock.now()
+    assert {loan.due_at for loan in await _loans(loan_ids)} == {issued_at + timedelta(days=21)}
+
+    assert await act(jobs.flag_overdue, issued_at + timedelta(days=21)) == []
+    flagged = await act(jobs.flag_overdue, issued_at + timedelta(days=21, minutes=1))
+    assert sorted(flagged) == sorted(loan_ids)
+    assert await act(jobs.flag_overdue, issued_at + timedelta(days=30)) == []
+    async with db.sessionmaker()() as s:
+        fines = (await s.scalars(select(Fine).where(Fine.application_id == app_id))).all()
+    assert sorted(f.loan_id for f in fines) == sorted(loan_ids)
+    assert {f.kind for f in fines} == {"overdue"}
+
+
