diff --git a/tests/test_loans.py b/tests/test_loans.py
new file mode 100644
index 0000000..cad5838
--- /dev/null
+++ b/tests/test_loans.py
@@ -0,0 +1,43 @@
+from datetime import timedelta
+
+from libs import clock
+from services.billing import public as billing
+from services.scheduling import jobs
+from services.scheduling import service as scheduling
+from services.scheduling.models import Loan
+from tests.factories import CHECKER, MSK, act, issue, paid_application, read, travel
+
+
+async def run_overdue_job() -> list[int]:
+    return await act(jobs.flag_overdue, clock.now())
+
+
+async def test_loan_period_is_21_days_from_issue() -> None:
+    app_id, _ = await paid_application()
+    [loan_id] = await issue(app_id)
+    issued_at = clock.now()
+
+    loan = await read(lambda s: s.get(Loan, loan_id))
+    assert loan.due_at == issued_at + timedelta(days=21)
+
+    travel(issued_at + timedelta(days=21))
+    assert await run_overdue_job() == []
+    assert await read(billing.open_fines_count, app_id) == 0
+
+    travel(issued_at + timedelta(days=21, minutes=1))
+    assert await run_overdue_job() == [loan_id]
+    assert await read(billing.open_fines_count, app_id) == 1
+
+    assert await run_overdue_job() == []
+    assert await read(billing.open_fines_count, app_id) == 1
+
+
+async def test_returned_book_is_not_flagged_overdue() -> None:
+    app_id, _ = await paid_application()
+    [loan_id] = await issue(app_id)
+    issued_at = clock.now()
+    await act(scheduling.return_book, loan_id, CHECKER[MSK])
+
+    travel(issued_at + timedelta(days=22))
+    assert await run_overdue_job() == []
+    assert await read(billing.open_fines_count, app_id) == 0
