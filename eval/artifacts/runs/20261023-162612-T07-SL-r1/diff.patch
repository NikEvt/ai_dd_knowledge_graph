+# @rule R-SCHED-VENUE-LIMIT-01
+async def set_venue_limit(session: AsyncSession, venue_id: int, max_capacity: int) -> None:
+    """Обновить реплику максимума мест; будущие окна со старым максимумом получают новый.
+
+    Окна, где проверяющий оператор уменьшил число мест, прошедшие и удалённые окна не меняются.
+    """
+    limit = await session.get(VenueLimit, venue_id)
+    if limit is None:
+        session.add(VenueLimit(venue_id=venue_id, max_capacity=max_capacity))
+        return
+    old = limit.max_capacity
+    limit.max_capacity = max_capacity
+    if old == max_capacity:
+        return
+    # Сначала лимит: триггер trg_slot_capacity_limit сверяет новое число мест с venue_limits.
+    await session.flush()
+    await session.execute(
+        update(Slot)
+        .where(
+            Slot.venue_id == venue_id,
+            Slot.capacity == old,
+            Slot.starts_at > clock.now(),
+            Slot.removed.is_(False),
+        )
+        .values(capacity=max_capacity)
+    )
+
+
 async def _active_bookings(session: AsyncSession, slot_id: int) -> int:
     return await session.scalar(
         select(func.count()).where(Booking.slot_id == slot_id, Booking.status == "active")
