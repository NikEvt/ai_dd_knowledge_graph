diff --git a/tests/test_dedup.py b/tests/test_dedup.py
new file mode 100644
index 0000000..f3cea37
--- /dev/null
+++ b/tests/test_dedup.py
@@ -0,0 +1,58 @@
+from tests.factories import (
+    BOOK_L1,
+    CLIENT_B,
+    LAW,
+    REP_DEBT,
+    application,
+    new_application,
+    paid_application,
+    pass_review,
+    stage,
+)
+
+
+async def test_social_review_closes_paid_duplicate() -> None:
+    paid_id = await new_application()
+    social_id = await new_application(social=True)
+    await pass_review(social_id)
+    assert await stage(social_id) == "awaiting_issue"
+    assert await stage(paid_id) == "closed_duplicate"
+    assert (await application(paid_id)).attempts[-1].outcome == "duplicate"
+
+
+async def test_social_review_closes_debt_duplicate() -> None:
+    debt_id = await new_application(rep=REP_DEBT)
+    social_id = await new_application(social=True)
+    await pass_review(social_id)
+    assert await stage(debt_id) == "closed_duplicate"
+
+
+async def test_social_review_closes_social_duplicate() -> None:
+    first_id = await new_application(social=True)
+    second_id = await new_application(social=True)
+    await pass_review(second_id)
+    assert await stage(first_id) == "closed_duplicate"
+
+
+async def test_debt_review_closes_social_duplicate() -> None:
+    social_id = await new_application(social=True)
+    debt_id = await new_application(rep=REP_DEBT)
+    await pass_review(debt_id)
+    assert await stage(debt_id) == "awaiting_issue"
+    assert await stage(social_id) == "closed_duplicate"
+
+
+async def test_full_payment_closes_social_duplicate() -> None:
+    social_id = await new_application(social=True)
+    paid_id, _ = await paid_application()
+    assert await stage(paid_id) == "awaiting_issue"
+    assert await stage(social_id) == "closed_duplicate"
+
+
+async def test_other_sphere_or_client_is_not_duplicate() -> None:
+    other_sphere = await new_application(sphere=LAW, books=(BOOK_L1,))
+    other_client = await new_application(client=CLIENT_B)
+    social_id = await new_application(social=True)
+    await pass_review(social_id)
+    assert await stage(other_sphere) == "draft"
+    assert await stage(other_client) == "draft"
