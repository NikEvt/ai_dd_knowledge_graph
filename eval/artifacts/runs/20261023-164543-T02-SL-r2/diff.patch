diff --git a/tests/test_loans.py b/tests/test_loans.py
new file mode 100644
index 0000000..47eb6d9
--- /dev/null
+++ b/tests/test_loans.py
@@ -0,0 +1,33 @@
+from datetime import timedelta
+
+from libs import settings
+from services.billing import public as billing_public
+from services.scheduling import jobs
+from services.scheduling.models import Loan
+from tests.factories import act, issue, paid_application, read
+
+
+async def _loan(loan_id: int) -> Loan:
+    return await read(lambda s: s.get(Loan, loan_id))
+
+
+# @rule R-SCHED-ISSUE-02
+async def test_loan_due_in_21_days_from_issue() -> None:
+    app_id, _ = await paid_application()
+    [loan_id] = await issue(app_id)
+    loan = await _loan(loan_id)
+    assert settings.LOAN_PERIOD_DAYS == 21
+    assert loan.due_at == loan.issued_at + timedelta(days=21)
+
+
+# @rule R-SCHED-OVERDUE-01
+async def test_overdue_flagged_after_due_date() -> None:
+    app_id, _ = await paid_application()
+    [loan_id] = await issue(app_id)
+    due_at = (await _loan(loan_id)).due_at
+
+    assert await act(jobs.flag_overdue, now=due_at - timedelta(minutes=1)) == []
+    assert await act(jobs.flag_overdue, now=due_at + timedelta(minutes=1)) == [loan_id]
+    assert await act(jobs.flag_overdue, now=due_at + timedelta(days=1)) == []
+    assert (await _loan(loan_id)).overdue_flagged
+    assert await read(billing_public.open_fines_count, app_id) == 1
