+async def _capacity(slot_id: int) -> int:
+    async with db.sessionmaker()() as s:
+        return (await s.get(Slot, slot_id)).capacity
+
+
+async def test_venue_maximum_change_updates_future_slots_with_old_maximum() -> None:
+    raised = await slot(MSK, HISTORY, T0 + timedelta(days=5))
+    smaller = await slot(MSK, HISTORY, T0 + timedelta(days=5), capacity=2)
+    reduced = await slot(MSK, HISTORY, T0 + timedelta(days=6))
+    await act(scheduling.reduce_capacity, reduced, CHECKER[MSK], 2)
+    other_venue = await slot(KZN, HISTORY, T0 + timedelta(days=5))
+
+    await act(admin.set_venue_max_capacity, MSK, 5)
+
+    assert await _capacity(raised) == 5
+    assert await _capacity(smaller) == 2
+    assert await _capacity(reduced) == 2
+    assert await _capacity(other_venue) == 3
+
+
+async def test_venue_maximum_change_skips_past_slots() -> None:
+    past = await slot(MSK, HISTORY, T0 + timedelta(days=1))
+    future = await slot(MSK, HISTORY, T0 + timedelta(days=5))
+    travel(T0 + timedelta(days=2))
+
+    await act(admin.set_venue_max_capacity, MSK, 2)
+
+    assert await _capacity(past) == 3
+    assert await _capacity(future) == 2
+
