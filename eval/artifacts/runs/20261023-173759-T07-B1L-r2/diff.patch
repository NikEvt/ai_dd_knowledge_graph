+async def test_slot_reduced_by_checker_keeps_capacity_even_when_it_matches_old_maximum() -> None:
+    reduced = await slot(MSK, HISTORY, T0 + timedelta(days=5))
+    await act(scheduling.reduce_capacity, reduced, CHECKER[MSK], 2)
+    await act(admin.set_venue_max_capacity, MSK, 2)
+    following = await slot(MSK, HISTORY, T0 + timedelta(days=5))
+
+    await act(admin.set_venue_max_capacity, MSK, 4)
+
+    assert await _capacity(reduced) == 2
+    assert await _capacity(following) == 4
+
