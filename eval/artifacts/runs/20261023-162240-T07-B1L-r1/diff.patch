+async def test_venue_maximum_change_updates_future_default_slots() -> None:
+    past = await slot(MSK, HISTORY, T0 + timedelta(days=1))
+    default = await slot(MSK, HISTORY, T0 + timedelta(days=5))
+    explicit = await slot(MSK, HISTORY, T0 + timedelta(days=5), capacity=2)
+    reduced = await slot(MSK, HISTORY, T0 + timedelta(days=6))
+    await act(scheduling.reduce_capacity, reduced, CHECKER[MSK], 2)
+    other_venue = await slot(KZN, HISTORY, T0 + timedelta(days=5))
+    travel(T0 + timedelta(days=2))
+
+    await act(admin.set_venue_max_capacity, MSK, 5)
+    assert await _capacity(default) == 5
+    assert await _capacity(past) == 3
+    assert await _capacity(explicit) == 2
+    assert await _capacity(reduced) == 2
+    assert await _capacity(other_venue) == 3
+
+    await act(admin.set_venue_max_capacity, MSK, 2)
+    assert await _capacity(default) == 2
+    assert await _capacity(past) == 3
+
+    # Уменьшенное проверяющим окно не трогается, даже если его число мест совпало со старым максимумом.
+    await act(admin.set_venue_max_capacity, MSK, 4)
+    assert await _capacity(default) == 4
+    assert await _capacity(explicit) == 4
+    assert await _capacity(reduced) == 2
