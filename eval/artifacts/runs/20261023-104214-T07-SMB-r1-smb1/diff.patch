+# @rule R-SCHED-VENUE-LIMIT-01
+async def apply_venue_max_capacity(session: AsyncSession, venue_id: int, max_capacity: int) -> None:
+    """Обновляет лимит площадки и переносит его на будущие окна, где мест было ровно по старому лимиту."""
+    limit = await session.get(VenueLimit, venue_id)
+    if limit is None:
+        session.add(VenueLimit(venue_id=venue_id, max_capacity=max_capacity))
+        return
+    old = limit.max_capacity
+    limit.max_capacity = max_capacity
+    # Сначала лимит, потом окна: trg_slot_capacity_limit сверяет capacity с venue_limits.
+    await session.flush()
+    if old == max_capacity:
+        return
+    await session.execute(
+        update(Slot)
+        .where(
+            Slot.venue_id == venue_id,
+            Slot.capacity == old,
+            Slot.capacity_reduced.is_(False),
+            Slot.removed.is_(False),
+            Slot.starts_at > clock.now(),
+        )
+        .values(capacity=max_capacity)
+        .execution_options(synchronize_session="fetch")
+    )
+
