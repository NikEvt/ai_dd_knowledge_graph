+async def apply_venue_limit(session: AsyncSession, venue_id: int, max_capacity: int) -> list[int]:
+    """Обновляет реплику максимума мест и подтягивает к нему будущие окна площадки.
+
+    Меняются только неудалённые окна, где число мест равнялось старому максимуму и не уменьшалось
+    проверяющим оператором. Возвращает id изменённых окон.
+    """
+    # @rule R-SCHED-VENUE-LIMIT-01
+    limit = await session.get(VenueLimit, venue_id, with_for_update=True)
+    if limit is None:
+        session.add(VenueLimit(venue_id=venue_id, max_capacity=max_capacity))
+        return []
+    old = limit.max_capacity
+    if old == max_capacity:
+        return []
+    limit.max_capacity = max_capacity
+    # лимит пишем раньше окон: триггер trg_slot_capacity_limit сверяет capacity с venue_limits
+    await session.flush()
+
+    # @rule R-SCHED-VENUE-LIMIT-02
+    slots = (
+        await session.scalars(
+            select(Slot)
+            .where(
+                Slot.venue_id == venue_id,
+                Slot.removed.is_(False),
+                Slot.starts_at > clock.now(),
+                Slot.capacity == old,
+                Slot.capacity_manual.is_(False),
+            )
+            .with_for_update()
+        )
+    ).all()
+    for slot in slots:
+        slot.capacity = max_capacity
+    await session.flush()
+    return [slot.id for slot in slots]
+
