diff --git a/migrations/versions/0002_social_venue_change.py b/migrations/versions/0002_social_venue_change.py
new file mode 100644
index 0000000..371812d
--- /dev/null
+++ b/migrations/versions/0002_social_venue_change.py
@@ -0,0 +1,40 @@
+"""social applications may change venue after booking link, until books are issued
+
+Revision ID: 0002
+Revises: 0001
+"""
+
+from alembic import op
+
+revision = "0002"
+down_revision = "0001"
+branch_labels = None
+depends_on = None
+
+
+def _venue_lock(locked_kinds: str) -> str:
+    return f"""
+CREATE OR REPLACE FUNCTION applications.forbid_venue_change() RETURNS trigger AS $$
+BEGIN
+    IF NEW.venue_id IS DISTINCT FROM OLD.venue_id THEN
+        IF OLD.stage IN ('books_out','closed','closed_duplicate') THEN
+            RAISE EXCEPTION 'venue change forbidden after books were issued'
+                USING ERRCODE = 'check_violation';
+        END IF;
+        IF OLD.kind IN ({locked_kinds})
+           AND OLD.stage NOT IN ('draft','on_review','needs_rework','archived') THEN
+            RAISE EXCEPTION 'venue change forbidden after booking link for % application', OLD.kind
+                USING ERRCODE = 'check_violation';
+        END IF;
+    END IF;
+    RETURN NEW;
+END $$ LANGUAGE plpgsql
+"""
+
+
+def upgrade() -> None:
+    op.get_bind().exec_driver_sql(_venue_lock("'debt'"))
+
+
+def downgrade() -> None:
+    op.get_bind().exec_driver_sql(_venue_lock("'social','debt'"))
