diff --git a/tests/test_dedup.py b/tests/test_dedup.py
new file mode 100644
index 0000000..bcc249e
--- /dev/null
+++ b/tests/test_dedup.py
@@ -0,0 +1,58 @@
+from tests.factories import (
+    BOOK_L1,
+    CLIENT_B,
+    LAW,
+    REP_DEBT,
+    application,
+    invoice,
+    new_application,
+    paid_application,
+    pass_review,
+    stage,
+    submit,
+)
+
+
+# @rule R-APP-DEDUP-01
+async def test_social_review_closes_paid_of_same_sphere() -> None:
+    paid = await new_application()
+    await pass_review(paid)
+    await invoice(paid)
+    social = await new_application(social=True)
+    await pass_review(social)
+    assert await stage(social) == "awaiting_issue"
+    assert await stage(paid) == "closed_duplicate"
+    assert (await application(paid)).attempts[-1].outcome == "duplicate"
+
+
+# @rule R-APP-DEDUP-01
+async def test_full_payment_closes_social_of_same_sphere() -> None:
+    social = await new_application(social=True)
+    await submit(social)
+    paid, _ = await paid_application()
+    assert await stage(paid) == "awaiting_issue"
+    assert await stage(social) == "closed_duplicate"
+
+
+# @rule R-APP-DEDUP-01
+async def test_debt_review_closes_social_and_social_review_closes_debt() -> None:
+    social = await new_application(social=True)
+    debt = await new_application(rep=REP_DEBT)
+    await pass_review(debt)
+    assert await stage(social) == "closed_duplicate"
+
+    debt_2 = await new_application(rep=REP_DEBT, sphere=LAW, books=(BOOK_L1,))
+    social_2 = await new_application(social=True, sphere=LAW, books=(BOOK_L1,))
+    await pass_review(social_2)
+    assert await stage(debt_2) == "closed_duplicate"
+    assert await stage(debt) == "awaiting_issue"
+
+
+# @rule R-APP-DEDUP-01
+async def test_social_review_keeps_other_sphere_and_other_client() -> None:
+    other_sphere = await new_application(sphere=LAW, books=(BOOK_L1,))
+    other_client = await new_application(client=CLIENT_B)
+    social = await new_application(social=True)
+    await pass_review(social)
+    assert await stage(other_sphere) == "draft"
+    assert await stage(other_client) == "draft"
