+"""social applications may change venue until books are issued
+
+Revision ID: 0002
+Revises: 0001
+"""
+
+from alembic import op
+
+revision = "0002"
+down_revision = "0001"
+branch_labels = None
+depends_on = None
+
+
+def _forbid_venue_change(locked_kinds: str) -> str:
+    return f"""
+CREATE OR REPLACE FUNCTION applications.forbid_venue_change() RETURNS trigger AS $$
+BEGIN
+    IF NEW.venue_id IS DISTINCT FROM OLD.venue_id THEN
+        IF OLD.stage IN ('books_out','closed','closed_duplicate') THEN
+            RAISE EXCEPTION 'venue change forbidden after books were issued'
+                USING ERRCODE = 'check_violation';
+        END IF;
+        IF OLD.kind IN ({locked_kinds})
+           AND OLD.stage NOT IN ('draft','on_review','needs_rework','archived') THEN
+            RAISE EXCEPTION 'venue change forbidden after booking link for % application', OLD.kind
+                USING ERRCODE = 'check_violation';
+        END IF;
+    END IF;
+    RETURN NEW;
+END $$ LANGUAGE plpgsql;
+"""
+
+
+def upgrade() -> None:
+    op.get_bind().exec_driver_sql(_forbid_venue_change("'debt'"))
+
+
+def downgrade() -> None:
+    op.get_bind().exec_driver_sql(_forbid_venue_change("'social','debt'"))
