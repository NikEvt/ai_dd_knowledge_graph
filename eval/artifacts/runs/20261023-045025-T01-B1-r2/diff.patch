+async def test_social_venue_change_after_booking_link_reissues_link() -> None:
+    app_id = await new_application(social=True)
+    await pass_review(app_id)
+    old_token = await token(app_id)
+    booking_id = await book(app_id, await slot(MSK, HISTORY, T0 + timedelta(days=3, hours=1)))
+
+    await act(apps.change_venue, app_id, OPERATOR, KZN)
+    app = await application(app_id)
+    assert app.venue_id == KZN
+    assert app.site_checker_id == CHECKER[KZN]
+    assert app.stage == "awaiting_issue"
+    booking = await read(lambda s, i: s.get(Booking, i), booking_id)
+    assert booking.status == "cancelled"
+    new_token = await token(app_id)
+    assert new_token is not None and new_token != old_token
+
+    await issue(app_id, venue=KZN)
+    assert await stage(app_id) == "books_out"
+
