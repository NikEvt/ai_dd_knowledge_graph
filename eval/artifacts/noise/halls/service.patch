+    await act(halls.change_venue, b.id, MANAGER[CENTER], LOFT_HALL)
+    inv = await invoice(b.id)
+    assert inv.amount == Decimal("12000.00")
+    assert await read(halls.paid_total, inv.id) == Decimal("10000.00")
