@@ -0,0 +1,17 @@
+"""Сроки и лимиты абонементов."""
+
+# Сколько дней после окончания оплаченного месяца абонемент ещё действует (статус grace).
+GRACE_DAYS = 30
+# За сколько дней до конца льготного периода напомнить об оплате.
+GRACE_REMINDER_DAYS = 5
+# Неоплаченный новый абонемент закрывается через столько дней.
+PENDING_TTL_DAYS = 14
+# Счёт на следующий месяц выставляется за столько дней до конца оплаченного.
+RENEWAL_INVOICE_DAYS = 7
+# Минимальный возраст держателя абонемента.
+MIN_HOLDER_AGE = 14
+# Социальный тариф оформляется с этого возраста (пенсионный) или до SOCIAL_MAX_STUDENT_AGE.
+SOCIAL_MIN_SENIOR_AGE = 60
+SOCIAL_MAX_STUDENT_AGE = 23
+# Сколько неоплаченных абонементов клиент может держать одновременно.
+MAX_PENDING_PER_CLIENT = 3
