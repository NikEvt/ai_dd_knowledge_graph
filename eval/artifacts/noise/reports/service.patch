+"""Сроки и лимиты сервиса отчётности."""
+
+# Завершённые запуски хранятся столько дней, затем удаляются вместе с уведомлениями.
+RETENTION_DAYS = 30
+# Запуск, который строится дольше этого, считается зависшим и помечается неуспешным.
+RUN_TIMEOUT_MINUTES = 30
+
+# Незавершённых ручных запусков на одного сотрудника одновременно.
+MAX_PENDING_RUNS_PER_USER = 3
+# Метрик в одном сводном отчёте.
+MAX_METRICS_PER_REPORT = 20
+# Период отчёта по умолчанию и максимальная глубина, дней.
+DEFAULT_PERIOD_DAYS = 7
+MAX_PERIOD_DAYS = 90
+
+# Интервал выгрузок по расписанию, часов.
+MIN_SCHEDULE_INTERVAL_HOURS = 1
+MAX_SCHEDULE_INTERVAL_HOURS = 24 * 31
+MAX_RECIPIENTS = 20
+
+# Сколько запусков отдаёт список за один раз.
+RUNS_PAGE_LIMIT = 100
+
+# Служебная метрика: число построенных отчётов за день в разрезе кода отчёта.
+RUNS_COMPLETED_METRIC = "reports.runs_completed"
